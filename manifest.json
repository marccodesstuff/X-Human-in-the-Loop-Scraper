{
  "manifest_version": 3,
  "name": "X-OSINT Collector",
  "version": "0.1",
  "description": "Collects tweet data passively from X/Twitter DOM during normal browsing.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.twitter.com/*",
    "*://*.x.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["*://*.twitter.com/*", "*://*.x.com/*"],
      "js": ["selectors.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
  ,
  "browser_specific_settings": {
    "gecko": {
      "id": "xosint@local",
      "strict_min_version": "91.0"
    }
  }
}
